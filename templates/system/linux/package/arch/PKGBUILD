# Maintainer: username <example@linux.com>
pkgname=apppackage
pkgver=1.0.0
pkgrel=1
pkgdesc="Description"
arch=('any')
url="https://github.com/"
license=('MIT')
_repo=AppPackage
_username=yourusername


depends=(
    'python'
)

makedepends=(
    'python-build'
    'python-installer'
    'python-wheel'
    'python-setuptools'
)

source=(
    "$pkgname-$pkgver.tar.gz::https://github.com/${username}/${_repo}/archive/refs/tags/v$pkgver.tar.gz"
)

sha256sums=('PUT_HASH_CODE_HERE!')

build() {
    cd "$srcdir/${_repo}-${pkgver}"
    python -m build --wheel --no-isolation
}

package() {
    cd "$srcdir/${_repo}-${pkgver}"

    python -m installer \
        --destdir="$pkgdir" \
	--compile-bytecode=2 \
        dist/*.whl

    install -Dm644 LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}